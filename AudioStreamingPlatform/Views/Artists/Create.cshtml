@model AudioStreamingPlatform.Models.Artist

<div class="container py-5">
    <h1 class="mb-4">➕ Create New Artist</h1>

    <form asp-action="Create">
        <div class="mb-3">
            <label asp-for="Title" class="form-label">Title</label>
            <input asp-for="Title" class="form-control" placeholder="Artist Name" />
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" placeholder="About the artist"></textarea>
        </div>
        <button type="submit" class="btn">Create</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>