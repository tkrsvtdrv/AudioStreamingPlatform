@model IEnumerable<AudioStreamingPlatform.Models.Song>

<div class="container py-5">
    <h1 class="mb-4">🎧 Songs</h1>
    <p>
        <a class="btn" href="@Url.Action("Create")">Create New Song</a>
    </p>
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Artist</th>
                <th>Duration</th>
                <th>Release Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Artist.Title</td>
                    <td>@item.Duration</td>
                    <td>@item.ReleaseDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a class="btn" href="@Url.Action("Edit", new { id = item.Id })">Edit</a>
                        <a class="btn" href="@Url.Action("Details", new { id = item.Id })">Details</a>
                        <a class="btn btn-danger" href="@Url.Action("Delete", new { id = item.Id })">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>